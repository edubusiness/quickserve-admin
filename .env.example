# NextAuth (Auth.js v5) — generate a secret with: openssl rand -base64 32
AUTH_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Backend API base URL used by the browser (baked into the client bundle at build time)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Server-only API URL used by the NextAuth route (defaults to NEXT_PUBLIC_API_URL).
# In Docker/compose set this to the internal service host, e.g. http://api:4000
API_URL=http://localhost:4000
