# Server
PORT=4000
NODE_ENV=development

# CORS — frontend origin
CLIENT_ORIGIN=http://localhost:3000

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Database
# Leave MONGODB_URI empty to boot with the zero-config in-memory store (great for dev/demo).
# Set it to a real connection string to persist with MongoDB / Mongoose.
MONGODB_URI=
# MONGODB_URI=mongodb://localhost:27017/quickserve
